---
import Base from '../layouts/Base.astro';
import EntryList from '../components/EntryList.astro';
---
<Base title="BILL'S DIGITAL WORLD" description="Bill 的个人数字门户。探索 AI 与经营实践，阅读技术笔记，找到适合具体任务的工具。">
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow"><i></i> BILL 的个人数字门户</p>
      <h1 lang="en">Bill’s<br /><em>Digital World.</em></h1>
      <p class="intro">我把 AI、软件和日常经营中的实验，整理成项目、教程与可以直接使用的工具笔记。</p>
      <div class="actions"><a class="button" href="/projects/">浏览项目</a><a class="text-link" href="/blog/">阅读笔记</a></div>
    </div>
    <figure class="plate">
      <img src="/orbit.jpg" width="1000" height="730" alt="由密集铜色曲线勾勒的扭转环面" fetchpriority="high" />
      <figcaption><span>扭转环面</span><span lang="en">PARAMETRIC STUDY</span></figcaption>
    </figure>
  </section>
  <section class="shelf"><div class="section-head"><div><p class="eyebrow">PROJECTS</p><h2>项目手记</h2></div><a class="text-link" href="/projects/">全部项目</a></div><EntryList section="projects" limit={3} /></section>
  <section class="shelf"><div class="section-head"><div><p class="eyebrow">FIELD NOTES</p><h2>最新教程</h2></div><a class="text-link" href="/blog/">全部笔记</a></div><EntryList section="blog" limit={2} /></section>
</Base>
