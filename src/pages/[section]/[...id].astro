---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { sections, sectionKeys, entries, dateLabel } from '../../lib/library';
export async function getStaticPaths() {
  const groups = await Promise.all(sectionKeys.map(async section =>
    (await entries(section)).map(entry => ({ params: { section, id: entry.id }, props: { section, entry } }))));
  return groups.flat();
}
const { section, entry } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);
---
<Base title={data.title} description={data.description} article>
  <article class="reading"><a class="crumb" href={`/${section}/`}>{sections[section].label}</a>
    <header class="article-head"><p class="eyebrow">{data.category} <span> / </span> <time datetime={dateLabel(data.date)}>{dateLabel(data.date)}</time></p>
      <h1>{data.title}</h1><p class="intro">{data.description}</p></header>
    <div class="prose"><Content /></div>
    {'website' in data && <a href={data.website} class="button">打开工具官网</a>}
    <div class="back"><a class="text-link" href={`/${section}/`}>返回{sections[section].label}</a></div>
  </article>
</Base>
