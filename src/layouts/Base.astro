---
import '../styles/site.css';
import { github } from '../lib/library';
interface Props { title: string; description: string; noindex?: boolean; article?: boolean }
const { title, description, noindex = false, article = false } = Astro.props;
const brand = "BILL'S DIGITAL WORLD";
const fullTitle = title === brand ? title : `${title} · ${brand}`;
const path = Astro.url.pathname;
const canonical = new URL(path, Astro.site);
const navigation = [['/', '首页'], ['/about/', '关于'], ['/projects/', '项目'], ['/blog/', '博客 / 教程'], ['/tools/', 'AI 工具箱'], ['/contact/', '联系']];
---
<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#11171c" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  {noindex ? <meta name="robots" content="noindex,follow" /> : <link rel="canonical" href={canonical} />}
  <meta property="og:type" content={article ? 'article' : 'website'} />
  <meta property="og:locale" content="zh_CN" />
  <meta property="og:site_name" content={brand} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={new URL('/orbit.jpg', Astro.site)} />
  <meta property="og:image:alt" content="铜色等高线构成的数字雕塑" />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
</head>
<body>
  <a class="skip" href="#main">跳到正文</a>
  <header class="mast"><div class="wrap mast-inner">
    <a href="/" class="brand" aria-label="Bill's Digital World 首页"><span class="mark" aria-hidden="true">b</span><span>BILL’S <b>DIGITAL WORLD</b></span></a>
    <nav aria-label="主导航">{navigation.map(([url,label]) => <a href={url} aria-current={path === url ? 'page' : url !== '/' && path.startsWith(url) ? 'location' : undefined}>{label}</a>)}</nav>
  </div></header>
  <main id="main" class="wrap"><slot /></main>
  <footer class="wrap"><span>BILL’S DIGITAL WORLD</span><div><a href={github}>GitHub</a><a href="/contact/">联系 Bill</a></div></footer>
</body>
</html>
